# Postgres connection — either a regular postgres:// URL or a local
# Prisma Postgres URL from `npx prisma dev` (prisma+postgres://...)
DATABASE_URL="postgresql://user:password@localhost:5432/epos"

# NextAuth
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_URL="http://localhost:3000"

# Platform brand defaults (white-label fallback)
NEXT_PUBLIC_PLATFORM_NAME="Epossis"
NEXT_PUBLIC_PLATFORM_LOGO_URL=""
NEXT_PUBLIC_PLATFORM_PRIMARY="#3b82f6"
NEXT_PUBLIC_PLATFORM_ACCENT="#0ea5e9"
